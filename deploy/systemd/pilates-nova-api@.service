[Unit]
Description=Pilates Nova - API (%i)
After=network.target postgresql.service

[Service]
# 1 processo: o rate limit em memória e o resolvedor de escopo são por processo (use RATE_LIMIT_BACKEND=banco para vários).
# As tarefas periódicas ficam no serviço worker.
User=__USUARIO__
WorkingDirectory=__BASE__/%i/backend
EnvironmentFile=__BASE__/%i/backend/.env
ExecStart=__BASE__/%i/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port ${API_PORTA} --workers 1 --proxy-headers
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
