[Unit]
Description=MayaCorp Automações - Robôs / fila de lotes (%i)
After=network.target postgresql.service

[Service]
User=__USUARIO__
WorkingDirectory=__BASE__/%i/backend
EnvironmentFile=__BASE__/%i/backend/.env
ExecStart=__BASE__/%i/backend/.venv/bin/python -m app.worker
Restart=always
RestartSec=5
# deixa o sublote em andamento terminar antes de parar
TimeoutStopSec=180
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
