# MayaCorp Automações — __DOMINIO__  (gerado por deploy/instalar.sh)
# Sem `map` global de propósito: outros sites deste servidor podem já declarar $connection_upgrade.
server {
    listen 80;
    server_name __DOMINIO__;
    client_max_body_size 25m;

    # Comunicador (chat ao vivo): WebSocket
    location /api/ws/ {
        proxy_pass http://127.0.0.1:__API__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:__API__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE do progresso dos lotes: sem buffer, conexão longa
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:__WEB__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
