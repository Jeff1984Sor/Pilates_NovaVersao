# Pilates Nova (__AMB__) - __DOMINIO__  (gerado por deploy/instalar.sh)
# Sem `map` global de propósito: outros sites deste servidor podem já declarar variáveis do mesmo nome.
# As zonas de rate limit têm o ambiente no nome para não colidir com as de outros sites.
limit_req_zone $binary_remote_addr zone=pilates_nova___AMB___auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=pilates_nova___AMB___geral:10m rate=20r/s;
limit_req_status 429;

server {
    listen 80;
    server_name __DOMINIO__;
    client_max_body_size 12m;   # uploads (fotos, documentos) até 10 MB + margem

    # Cabeçalhos de segurança (o certbot mantém estes ao criar o bloco 443)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    server_tokens off;

    # Login e recuperação de senha: limite apertado por IP (a API tem o seu próprio limite além deste)
    location ~ ^/bff/auth/(login|forgot|reset|forgot-codigo|reset-codigo)$ {
        limit_req zone=pilates_nova___AMB___auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:__WEB__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # sobrescreve: o cliente não forja o próprio IP
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Única parte da API exposta direto à internet: integração externa, app do aluno, webhooks, link assinado e health.
    # Todo o resto de /api (login, configurações, dados) só é alcançado pelo Next (BFF), por dentro do servidor.
    location ~ ^/api/(integracao|aluno-app|webhooks|arquivos-publicos|health)(/|$) {
        limit_req zone=pilates_nova___AMB___geral burst=40 nodelay;
        proxy_pass http://127.0.0.1:__API__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/ {
        return 404;
    }

    location / {
        limit_req zone=pilates_nova___AMB___geral burst=60 nodelay;
        proxy_pass http://127.0.0.1:__WEB__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
