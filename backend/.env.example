# Copie para backend/.env e ajuste. Nunca versione o .env.
AMBIENTE=dev                       # dev | hml | prod
API_PORTA=8000                     # usado pelo systemd (hml: 8100)
DATABASE_URL=sqlite:///./data/dev.db
# DATABASE_URL=postgresql+psycopg://mayacorp:SENHA@127.0.0.1:5432/automacoes_hml
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo
# Chave mestra do certificado (Fernet). Gere com:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Fica SÓ aqui (fora do banco). Perdeu a chave = reenviar o certificado.
MASTER_KEY=

# Modo da Prefeitura (simulado / teste / produção), SMTP, usuários, certificado e identidade
# são configurados na tela Configurações. Emissão real só é liberada quando AMBIENTE=prod.

# Produção: WORKER_EMBUTIDO=false (o serviço app.worker processa a fila) e MIGRAR_NA_SUBIDA=false
WORKER_EMBUTIDO=true
MIGRAR_NA_SUBIDA=true

# Sem SMTP, os e-mails vão para storage/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CFME Advogados <nao-responda@mayacorp.com.br>
