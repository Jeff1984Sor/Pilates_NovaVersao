# Copie para backend/.env e ajuste. Nunca versione o .env. Aqui só NOMES e exemplos.
AMBIENTE=dev                       # dev | hml | prod
DEBUG=false                        # true só em dev (habilita /api/docs); hml/prod exigem false
ALLOWED_HOSTS=["localhost","127.0.0.1"]   # hml/prod: o domínio real + "127.0.0.1" (o Next chama a API por ele); sem "*" nem localhost
DATABASE_URL=sqlite:///./data/dev.db
# DATABASE_URL=postgresql+psycopg://pilates_nova:SENHA@127.0.0.1:5432/pilates_nova_hml
STORAGE_DIR=./storage
FRONTEND_URL=http://localhost:3000       # hml/prod: https://...
CORS_ORIGINS=["http://localhost:3000"]

# Obrigatórios e DIFERENTES do dev em hml/prod (a API não sobe com o valor de dev).
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# MASTER_KEY (Fernet; cifra senha SMTP, chave de IA e tokens de integração). Gere com:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Fica SÓ aqui (fora do banco). Perdeu a chave = reconfigurar os segredos. Backup em cofre separado.
MASTER_KEY=
# Rotação da MASTER_KEY: coloque a antiga aqui, rode a recifragem e depois apague.
MASTER_KEY_ANTERIOR=
# SECRET_KEY do Django antigo: só para aceitar links de assinatura já enviados (contrato/termo) após o cutover.
LEGACY_DJANGO_SECRET_KEY=

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
RATE_LIMIT_ATIVO=true
RATE_LIMIT_BACKEND=memoria         # memoria | banco (banco vale entre processos)
UPLOAD_MAX_MB=10
LINK_ASSINADO_HORAS=72

# Produção: WORKER_EMBUTIDO=false (o serviço app.worker faz as tarefas) e MIGRAR_NA_SUBIDA=false (migrations no deploy)
WORKER_EMBUTIDO=true
MIGRAR_NA_SUBIDA=true

# Fallback de SMTP (a tela Configurações › E-mail tem prioridade). Sem SMTP em dev, e-mails vão para storage/outbox/*.eml
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pilates <nao-responda@exemplo.com>

# Só para o seed/CLI (nunca commitar valores reais)
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
