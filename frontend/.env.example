# Copie para frontend/.env.local (dev) ou use o .env do ambiente (hml/prod). Só nomes e exemplos.
# Endereço INTERNO da API, usado só pelo servidor do Next (BFF). O navegador nunca fala com a API direto.
INTERNAL_API_URL=http://localhost:8000/api
# Cookies de sessão com flag Secure (padrão em produção). Só use false para testar produção em http local.
# COOKIE_SECURE=false
# Validade dos cookies (iguais a JWT_ACCESS_MINUTES / JWT_REFRESH_DAYS do backend)
# SESSAO_ACCESS_MINUTOS=30
# SESSAO_REFRESH_DIAS=14
NEXT_PUBLIC_AMBIENTE=dev      # dev | hml | prod (hml mostra a faixa vermelha)
NEXT_PUBLIC_VERSAO=v1
